<Project>
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <UseArtifactsOutput>true</UseArtifactsOutput>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Disabletransitiveprojectreferences>true</Disabletransitiveprojectreferences>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <!-- Debug with compiler optimizations: fast like Release, but keeps the DEBUG constant and asserts -->
    <PropertyGroup Condition="'$(Configuration)' == 'DebugOptimized'">
        <Optimize>true</Optimize>
        <DebugSymbols>true</DebugSymbols>
        <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    </PropertyGroup>

    <!-- Suppress SixLabors.ImageSharp 3.1 vulnerability warnings. Only 4.x fixes them, and 4.x needs a license key to build. -->
    <ItemGroup>
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    </ItemGroup>

    <!-- Workaround for https://github.com/dotnet/roslyn/issues/41640 -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Make RootNamespace and ProjectDir visible to analyzers for IDE0130 (namespace matching) -->
    <ItemGroup>
        <CompilerVisibleProperty Include="RootNamespace" />
        <CompilerVisibleProperty Include="ProjectDir" />
    </ItemGroup>
</Project>
