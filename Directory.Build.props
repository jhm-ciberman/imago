<Project>
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <UseArtifactsOutput>true</UseArtifactsOutput>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Disabletransitiveprojectreferences>true</Disabletransitiveprojectreferences>
    </PropertyGroup>

    <!-- Debug with compiler optimizations: fast like Release, but keeps the DEBUG constant and asserts -->
    <PropertyGroup Condition="'$(Configuration)' == 'DebugOptimized'">
        <Optimize>true</Optimize>
        <DebugSymbols>true</DebugSymbols>
        <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    </PropertyGroup>

    <!-- Suppress Newtonsoft.Json vulnerability warning from glTF2Loader transitive dependency -->
    <ItemGroup>
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-5crp-9r3c-p9vr" />
    </ItemGroup>

    <!-- Workaround for https://github.com/dotnet/roslyn/issues/41640 -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Make RootNamespace and ProjectDir visible to analyzers for IDE0130 (namespace matching) -->
    <ItemGroup>
        <CompilerVisibleProperty Include="RootNamespace" />
        <CompilerVisibleProperty Include="ProjectDir" />
    </ItemGroup>
</Project>
